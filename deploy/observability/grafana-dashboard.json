{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "SentinelOps",
  "uid": "sentinelops-overview",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "sentinelops"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Monitor last check age",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_last_check_age_seconds"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Monitor success ratio (1h)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_monitor_success_ratio"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active incidents",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_incidents_active)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Recovery rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_recovery_rate"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Alerts firing",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sentinel_alerts_firing)"
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Last backup age",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_backup_last_success_age_seconds"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Incidents detected / resolved",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sentinel_incidents_detected_total[1h]))",
          "legendFormat": "detected/h"
        },
        {
          "refId": "B",
          "expr": "sum by (resolution) (increase(sentinel_incidents_resolved_total[1h]))",
          "legendFormat": "resolved {{resolution}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Queue: outbox age, lag, pending",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_outbox_oldest_unpublished_age_seconds",
          "legendFormat": "outbox oldest (s)"
        },
        {
          "refId": "B",
          "expr": "sentinel_queue_lag",
          "legendFormat": "task lag"
        },
        {
          "refId": "C",
          "expr": "sentinel_queue_pending",
          "legendFormat": "task pending"
        },
        {
          "refId": "D",
          "expr": "sentinel_report_queue_lag",
          "legendFormat": "report lag"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "AI calls by outcome",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, outcome) (increase(sentinel_ai_calls_total[1h]))",
          "legendFormat": "{{stage}} {{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "AI tokens (and estimated cost)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, kind) (increase(sentinel_ai_usage_tokens_total[1h]))",
          "legendFormat": "{{stage}} {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(sentinel_ai_cost_usd_estimate_total[1h]))",
          "legendFormat": "USD estimate/h"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "AI latency (avg s)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(sentinel_ai_call_latency_seconds_sum[15m])) / sum by (stage) (rate(sentinel_ai_call_latency_seconds_count[15m]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Policy decisions",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, decision) (increase(sentinel_policy_decisions_total[1h]))",
          "legendFormat": "{{phase}} {{decision}}"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Actions and verifications",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (sentinel_actions_total)",
          "legendFormat": "action {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (status) (sentinel_verifications_total)",
          "legendFormat": "verification {{status}}"
        },
        {
          "refId": "C",
          "expr": "sentinel_duplicate_actions_prevented_total",
          "legendFormat": "duplicates prevented"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Reports",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (sentinel_reports_total)",
          "legendFormat": "{{mode}}"
        },
        {
          "refId": "B",
          "expr": "sentinel_report_validation_rejections_total",
          "legendFormat": "validator rejections"
        },
        {
          "refId": "C",
          "expr": "sentinel_report_ai_failures_total",
          "legendFormat": "AI path failed -> fallback"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Notifications",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, status) (sentinel_notification_deliveries)",
          "legendFormat": "{{channel}} {{status}}"
        },
        {
          "refId": "B",
          "expr": "sentinel_notification_retries_total",
          "legendFormat": "retries"
        },
        {
          "refId": "C",
          "expr": "sentinel_notifications_dead_lettered_total",
          "legendFormat": "dead-lettered"
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Service heartbeat age",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_service_heartbeat_age_seconds",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 16
    }
  ]
}
