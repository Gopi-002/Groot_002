# Copy to .env and fill in values. NEVER commit .env. No credentials here.
# Generate strong values, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL superuser for the sentinelops database (required, >=16 chars recommended)
POSTGRES_PASSWORD=
# Redis requirepass (required)
REDIS_PASSWORD=
# Token required by the demo app's /simulate-failure endpoint (>=16 chars, demo only)
DEMO_INJECTION_TOKEN=
# Bearer token for the read-only /v1 status API (>=32 chars). Empty => /v1 returns 503.
SENTINEL_API_READ_TOKEN=
# Token between the worker and the restricted ops-reader service (>=32 chars)
SENTINEL_OPS_READER_TOKEN=
# Worker <-> restricted executor bearer token (>=32 chars)
SENTINEL_EXECUTOR_TOKEN=
# HMAC key signing each short-lived, action-bound restart authorization (>=32 chars)
SENTINEL_ACTION_SIGNING_KEY=
# HMAC key signing human approval decisions; the worker verifies them (>=32 chars)
SENTINEL_APPROVAL_SIGNING_KEY=

# Remediation policy. Autonomous restart of the demo app is OFF by default. To allow it
# ONLY in this isolated demo, set BOTH (never in production; the policy denies there):
# SENTINEL_REMEDIATION_AUTO_ENABLED=true
# SENTINEL_REMEDIATION_ENVIRONMENT=isolated-demo
# With autonomy off but the environment declared, restarts need human approval:
# SENTINEL_REMEDIATION_ENVIRONMENT=isolated-demo
# SENTINEL_APPROVAL_TTL_SECONDS=900

# Group id owning /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock);
# granted ONLY to ops-reader (read-only) and executor (restart). Not a secret.
DOCKER_GID=

# AI provider: anthropic (API-key auth; key entered via `docker compose run --rm onboard`,
# stored in the ai_secrets volume - NEVER put the Anthropic key in this file) |
# mock (deterministic TEST/DEMO model, not Claude; forbidden in production)
SENTINEL_AI_GATEWAY=anthropic
# Per-investigation budgets (defaults shown). Cost cap needs operator-supplied prices.
# SENTINEL_AI_MAX_TOOL_CALLS=6
# SENTINEL_AI_MAX_REASONING_ATTEMPTS=3
# SENTINEL_AI_INVESTIGATION_TIMEOUT_SECONDS=600
# SENTINEL_AI_MAX_TOTAL_TOKENS=300000
# SENTINEL_AI_INPUT_USD_PER_MTOK=
# SENTINEL_AI_OUTPUT_USD_PER_MTOK=
# SENTINEL_AI_MAX_COST_USD=

# Durable AI budgets (Phase 5; enforced from the ai_usage ledger for investigation AND
# reports). Exhausting the daily budget pauses AI until the next UTC day (monitoring
# continues, an alert fires). Currency ceilings need the operator prices above; costs
# are always labelled as ESTIMATES - no provider price is hardcoded.
# SENTINEL_AI_DAILY_MAX_TOKENS=2000000
# SENTINEL_AI_DAILY_MAX_COST_USD=
# SENTINEL_AI_INCIDENT_MAX_TOKENS=600000
# SENTINEL_AI_MAX_CONCURRENT_JOBS=2
# Reporting: AI drafts are validated against records; otherwise a deterministic
# fallback report is produced. Set false to always use the deterministic renderer.
# SENTINEL_REPORT_AI_ENABLED=true

# Notifications (Phase 5). Channels: log (always) and webhook (ONE trusted URL whose
# host must be in the allowlist; https required outside development/test/demo).
# The local default posts to the dev/test-only notify-sink container.
# SENTINEL_NOTIFY_CHANNELS=log,webhook
# SENTINEL_NOTIFY_WEBHOOK_URL=https://hooks.example.com/sentinelops
# SENTINEL_NOTIFY_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# HMAC-SHA256 signing secret for webhook deliveries (>=32 chars; required in production)
SENTINEL_NOTIFY_WEBHOOK_SECRET=
# Alerting: require a successful backup at least this often (unset = not expected)
# SENTINEL_BACKUP_MAX_AGE_HOURS=26

# development | demo | test | production
SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
# demo | production  (production disables /simulate-failure entirely)
DEMO_ENV=demo
DEMO_FAILURE_INJECTION_ENABLED=true

# Monitoring cadence (defaults: 30s interval, 5s timeout, 3 failures / 3 slow >2s, 3 healthy to re-arm)
# SENTINEL_MONITOR_INTERVAL_SECONDS=30
# SENTINEL_REDISPATCH_AFTER_SECONDS=300
